# Tech Release Radar - Environment Variables

# Bedrock Config (Optional - used for AI-based analysis)
BEDROCK_ENABLED=false
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# GitHub Source Config
GITHUB_TOKEN=your_github_personal_access_token_here

# Database Config (DynamoDB Table names)
DYNAMODB_RELEASES_TABLE=tech_release_radar_releases
DYNAMODB_PROJECTS_TABLE=tech_release_radar_projects

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
